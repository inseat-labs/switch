{
  "name": "switch-llm",
  "version": "0.2.1",
  "description": "Snapshot tests for AI model upgrades: run your prompts on the current and the candidate model and see which tool-calling behaviors consistently change.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "switch": "./dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli/main.ts",
    "check:examples": "tsx src/cli/main.ts check examples/fixtures/*.json",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inseat-labs/switch.git"
  },
  "homepage": "https://switch.inseat.app",
  "bugs": {
    "url": "https://github.com/inseat-labs/switch/issues"
  },
  "keywords": [
    "llm",
    "model-migration",
    "model-upgrade",
    "snapshot-testing",
    "tool-calling",
    "claude",
    "evaluation",
    "compatibility"
  ],
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
